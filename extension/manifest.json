{
  "manifest_version": 3,
  "name": "Unfugly",
  "version": "2.0.06",
  "description": "Revamp your Academia with a unified dashboard and Auto-generates a downloadable timetable",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequest",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://srmist.edu.in/*",
    "https://*.srmist.edu.in/*",
    "https://dld.srmist.edu.in/*",
    "https://theajack.github.io/*",
    "https://creatorapp.zoho.com/srm_university/*",
    "https://unfugly-backend.onrender.com/*",
    "http://localhost:5000/*",
    "https://zoho.in/*",
    "https://*.zoho.in/*",
    "https://zoho.com/*",
    "https://*.zoho.com/*",
    "https://*.zohocdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://academia.srmist.edu.in/*", "https://creatorapp.zoho.com/srm_university/*"],
      "js": ["utils/logger.js", "lib/html2canvas.min.js", "api/courseRegistration.js", "api/unifiedTimetable.js", "api/attendance.js", "api/calendar.js", "analytics.js", "content.js", "editTimetable.js", "predict.js", "imageURLScript.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.srmist.edu.in/staff-finder/*"],
      "js": ["staffFinderAssistant.js"]
    },
    {
      "matches": ["https://sp.srmist.edu.in/*"],
      "js": ["sp_content.js"]
    },
    {
      "matches": [
        "https://dld.srmist.edu.in/ktretecurricula/*",
        "https://dld.srmist.edu.in/*"
      ],
      "js": [
        "lib/jsQR.js",
        "ktretecurricula.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "antidevtool_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "web_accessible_resources": [  
    {
      "resources": [
        "images/*",
        "lib/onnx/*",
        "offscreen.html"
      ],
      "matches": ["<all_urls>"] 
    }
  ]
}
